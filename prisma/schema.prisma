generator client {
  provider        = "prisma-client"
  output          = "../lib/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model user {
  id              Int             @id(map: "pk__user") @default(dbgenerated("nextval('_user_id_seq'::regclass)"))
  username        String          @unique(map: "unq__user") @db.VarChar(100)
  hashed_password String          @db.VarChar(255)
  created_at      DateTime        @default(now()) @db.Timestamptz(6)
  updated_at      DateTime        @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?       @db.Timestamptz(6)
  user_role_id    Int             @default(2)
  user_role       user_role       @relation(fields: [user_role_id], references: [id], onDelete: Cascade, map: "fk__user_user_role")
  borrowing       borrowing[]
  taking          taking[]
  user_sessions   user_sessions[]

  @@map("_user")
}

model borrowing {
  id          BigInt    @id(map: "pk_borrowing") @default(autoincrement())
  user_id     Int
  product_id  Int
  amount      Int
  returned    Boolean   @default(false)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  description String?
  user        user      @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_borrowing__user")
  products    products  @relation(fields: [product_id], references: [id], onDelete: Cascade, map: "fk_borrowing_products")
}

model products {
  name            String      @unique(map: "unique_nama_not_deleted", where: raw("(deleted_at IS NULL)")) @db.VarChar(255)
  stock           Int
  unit_id         Int
  borrowed        Boolean     @default(false)
  borrowed_amount Int         @default(0)
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime    @default(now()) @db.Timestamptz(6)
  deleted_at      DateTime?   @db.Timestamptz(6)
  id              Int         @id(map: "pk_products") @default(autoincrement())
  borrowing       borrowing[]
  unit            unit        @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_products_unit")
  taking          taking[]
}

model taking {
  user_id     Int
  product_id  Int
  amount      Int
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  id          Int       @id(map: "pk_taking") @default(autoincrement())
  description String?
  user        user      @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_taking__user")
  products    products  @relation(fields: [product_id], references: [id], onDelete: Cascade, map: "fk_taking_products")
}

model unit {
  name     String     @db.VarChar(100)
  id       Int        @id(map: "pk_unit") @default(autoincrement())
  products products[]
}

model user_role {
  name String @db.VarChar(100)
  id   Int    @id(map: "pk_user_role") @default(autoincrement())
  user user[]
}

model user_sessions {
  id             BigInt    @id @default(autoincrement())
  selector       String    @unique(map: "unq_user_sessions_selector") @db.VarChar(32)
  validator_hash String
  expired_at     DateTime  @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @db.Timestamptz(6)
  revoked_at     DateTime? @db.Timestamptz(6)
  user_id        Int
  user           user      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_user_sessions__user")

  @@index([selector], map: "idx_user_sessions_active", where: raw("(revoked_at IS NULL)"))
}
